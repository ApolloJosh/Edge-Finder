{
  "_readme": "Edge Finder settings. Payout tables change - check each app before trusting a breakeven, and edit the numbers here.",

  "odds_api": {
    "base": "https://api.the-odds-api.com/v4",
    "hours_ahead": 30,
    "budget_per_pull": 150
  },

  "books": {
    "pickem": ["prizepicks", "underdog"],
    "sportsbook": ["fliff"],
    "sharp": {
      "pinnacle": 1.5,
      "fanduel": 1.0,
      "draftkings": 1.0,
      "betonlineag": 0.5,
      "betmgm": 0.5,
      "espnbet": 0.5
    }
  },

  "leagues": {
    "nba": {
      "sport_key": "basketball_nba",
      "markets": [
        "player_points",
        "player_rebounds",
        "player_assists",
        "player_threes",
        "player_points_rebounds_assists"
      ],
      "kalshi_series": {
        "KXNBAPTS": "player_points",
        "KXNBAREB": "player_rebounds",
        "KXNBAAST": "player_assists",
        "KXNBA3PT": "player_threes",
        "KXNBAPRA": "player_points_rebounds_assists"
      }
    },
    "nfl": {
      "sport_key": "americanfootball_nfl",
      "markets": [
        "player_pass_yds",
        "player_pass_attempts",
        "player_rush_yds",
        "player_rush_attempts",
        "player_rush_reception_yds",
        "player_reception_yds",
        "player_receptions"
      ],
      "kalshi_series": {
        "KXNFLPASSYDS": "player_pass_yds",
        "KXNFLRSHYDS": "player_rush_yds",
        "KXNFLRECYDS": "player_reception_yds",
        "KXNFLREC": "player_receptions",
        "KXNFLRRYDS": "player_rush_reception_yds"
      }
    }
  },

  "max_line_gap": {
    "_note": "Furthest a book's line may sit from a sharp line before the sharp price is ignored instead of stretched.",
    "player_points": 2.0,
    "player_rebounds": 1.0,
    "player_assists": 1.0,
    "player_threes": 0.0,
    "player_points_rebounds_assists": 2.0,
    "player_pass_yds": 15,
    "player_pass_attempts": 2,
    "player_rush_yds": 10,
    "player_rush_attempts": 2,
    "player_rush_reception_yds": 10,
    "player_reception_yds": 10,
    "player_receptions": 1.0,
    "default": 1.0
  },

  "entries": {
    "_note": "pays: hits -> multiplier. PrizePicks from its help center (Payouts Explained, Oct 2026). Underdog is a placeholder - check the app and fix.",
    "prizepicks": {
      "pp2":  {"label": "PP Power 2",  "picks": 2, "pays": {"2": 3}},
      "pp3":  {"label": "PP Power 3",  "picks": 3, "pays": {"3": 5}},
      "pp4":  {"label": "PP Power 4",  "picks": 4, "pays": {"4": 10}},
      "pp5":  {"label": "PP Power 5",  "picks": 5, "pays": {"5": 20}},
      "pp6":  {"label": "PP Power 6",  "picks": 6, "pays": {"6": 37.5}},
      "ppf3": {"label": "PP Flex 3",   "picks": 3, "pays": {"3": 2.25, "2": 1.25}},
      "ppf4": {"label": "PP Flex 4",   "picks": 4, "pays": {"4": 5, "3": 1.5}},
      "ppf5": {"label": "PP Flex 5",   "picks": 5, "pays": {"5": 10, "4": 2, "3": 0.4}},
      "ppf6": {"label": "PP Flex 6",   "picks": 6, "pays": {"6": 25, "5": 2, "4": 0.4}}
    },
    "underdog": {
      "ud2": {"label": "UD Standard 2", "picks": 2, "pays": {"2": 3}, "verify": true},
      "ud3": {"label": "UD Standard 3", "picks": 3, "pays": {"3": 6}, "verify": true},
      "ud4": {"label": "UD Standard 4", "picks": 4, "pays": {"4": 10}, "verify": true},
      "ud5": {"label": "UD Standard 5", "picks": 5, "pays": {"5": 20}, "verify": true}
    }
  },

  "thresholds": {
    "pickem_cushion": 0.005,
    "adj_haircut_per_sd": 0.03,
    "max_shift": 0.08,
    "fliff_min_ev": 0.02,
    "kalshi_min_ev": 0.02,
    "min_sharp_books": 2,
    "one_book_ok": false,
    "entries_from_different_games": true
  },

  "auto": {
    "_note": "GitHub Actions runs every 15 minutes but only pulls lines when you press Run (board_offsets_min is empty). To pull automatically before each tip, set e.g. [90, 30]. closing_snapshots: about 1 credit per game, only for games you bet - turn off with false (CLV then can't be measured).",
    "leagues": ["nba", "nfl"],
    "board_offsets_min": [],
    "closing_snapshots": true,
    "min_lead_min": 5,
    "close_window_min": 30,
    "horizon_hours": 14,
    "daily_credit_cap": 350,
    "credit_floor": 40
  },

  "model": {
    "_note": "How much the overall score leans on Gridiron Edge (NFL) or Full Court Edge (NBA) instead of the sharp books' fair price. Keep it small until Results shows the model's read helps.",
    "weight": 0.25
  },

  "full_court_edge": {
    "_note": "Edge Finder's NBA model, built from ESPN box scores (free). Each scheduled run fetches up to requests_per_run pages, newest days first, back to back_to.",
    "requests_per_run": 200,
    "back_to": "2025-10-21"
  },

  "budget": {
    "_note": "Spending per day across everything, and the most any one bet gets. Suggested stakes split what's left today across the best picks.",
    "daily": 25,
    "nfl_sunday": 40,
    "max_share": 0.25
  },

  "manual": {
    "_note": "A Run pulls every game that hasn't started in the next this-many hours.",
    "hours_ahead": 16
  },

  "robinhood": {
    "_note": "The Check page, for apps without a price feed. fee_per_contract: Robinhood's commission plus exchange fee (an Oct 2026 order: 3 contracts at 64c cost $1.96, about 1.3c each). min_ev: the return a price must beat before the call is Take it.",
    "fee_per_contract": 0.015,
    "min_ev": 0.03
  },

  "github": {
    "repo": "ApolloJosh/Edge-Finder"
  },

  "kalshi": {
    "_note": "Kalshi buys by the dollar and fills fractional shares; the fee is 0.07 x P x (1 - P) a share. min_size: contracts that must be on offer at the ask before a line is flagged.",
    "base": "https://api.elections.kalshi.com/trade-api/v2",
    "min_size": 5
  },

  "gridiron_edge": {
    "_note": "Gridiron Edge market id -> Odds API market. 'biased' ones still price on a raw median that runs high (Gridiron Edge docs/medshrink.md).",
    "map": {
      "passYds": "player_pass_yds",
      "passAtt": "player_pass_attempts",
      "passCmp": "player_pass_completions",
      "passRushYds": "player_pass_rush_yds",
      "rushYds": "player_rush_yds",
      "rushAtt": "player_rush_attempts",
      "rushRecYds": "player_rush_reception_yds",
      "rbRec": "player_receptions",
      "recYds": "player_reception_yds",
      "rec": "player_receptions"
    },
    "biased": ["passYds", "passRushYds", "rushRecYds", "rbRec", "recYds:TE"],
    "agree_at": 0.55,
    "conflict_at": 0.45,
    "stale_days": 6
  }
}
